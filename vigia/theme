# Default+ theme for vigia
#
# Place at ~/.config/vigia/theme, or point to it with:
#   VIGIA_THEME=~/path/to/this/file
#
# Colours come from palette.yaml; `bin/build.py --validate` checks them.
# Syntax roles follow Xcode: comments are GREEN and strings are RED. Diff
# sigils use the status colours instead, so they stay distinct from syntax.

base = dark

# Chrome — cyan primary accent
chrome     = #35B0D8 bold
chrome_dim = #8E8E8E

# File list — three recency rungs
path      = #FFFFFF bold
path_live = #FFFFFF
path_cold = #8E8E8E
pulse     = #35B0D8
spark     = #35B0D8
spark_track = #242424

# Scrollbar
bar       = #8E8E8E
bar_track = #242424

# Heat strip — each ramp walks muted -> base -> bright
heat_track        = #242424
heat_added        = #226039
heat_added_warm   = #2EA85B
heat_added_hot    = #41B645
heat_removed      = #8A2E34
heat_removed_warm = #FC4651
heat_removed_hot  = #F74A4A
heat_mixed        = #7C5A3E
heat_mixed_warm   = #E09D65
heat_mixed_hot    = #FFE76D

# Labels
kind   = #FFE76D
hunk   = #35B0D8
gutter = #4C4C4C

# Diff sigils
added   = #41B645
removed = #F74A4A
context = #FFFFFF

# Row washes (truecolor only)
added_row   = on #1C3425
removed_row = on #452023

# Status
note  = #56D0B3
alert = #F74A4A bold

# Syntax — Xcode's role map
keyword   = #F2248C
type_name = #56D0B3
function  = #56D0B3
variable  = #56D0B3
constant  = #FFE76D
string    = #FC4651
number    = #FFE76D
comment   = #2EA85B
