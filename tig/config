# Default+ theme for tig
# Generated by bin/build.py from palette.yaml — do not edit by hand.
#
# tig 2.6.1 has no truecolor support, so each palette entry is mapped to a
# 256-colour index. These are HAND-PICKED, not nearest-RGB: nearest-RGB puts
# the selection colour on the grey ramp right next to `muted`, collapsing two
# distinct roles. This table is the authority for this file.
#
#   base.background              -> color233 (#121212)
#   base.foreground              -> color231 (#ffffff)
#   base.selection               -> color60 (#5f5f87)
#   base.muted                   -> color239 (#4e4e4e)
#   base.muted_text              -> color245 (#8a8a8a)
#   syntax.comment               -> color35 (#00af5f)
#   syntax.string                -> color203 (#ff5f5f)
#   syntax.keyword               -> color198 (#ff0087)
#   syntax.number                -> color221 (#ffd75f)
#   syntax.attribute             -> color179 (#d7af5f)
#   syntax.url                   -> color75 (#5fafff)
#   syntax.declaration           -> color74 (#5fafd7)
#   syntax.project_identifier    -> color79 (#5fd7af)
#   syntax.system_member         -> color135 (#af5fff)

set vertical-split = false

# Base UI
color default          color231 color233
color cursor           color233 color221
color cursor-blur      color231 color60
color status           color231 color233
color title-focus      color233 color221
color title-blur       color231 color60
color search-result    color233 color221
color header           color231 color233
color line-number      color239 color233
color delimiter        color239 color233
color id               color221 color233
color date             color245 color233
color author           color79 color233
color committer        color245 color233
color mode             color239 color233
color overflow         color239 color233
color directory        color74 color233
color file             color231 color233
color file-size        color239 color233

# Diff view
color diff-add         color35 color233
color diff-del         color203 color233
color diff-header      color221 color233
color diff-chunk       color74 color233

# Log / commit graph
color graph-commit     color221 color233
color main-commit      color231 color233
color main-annotated   color79 color233
color main-head        color221 color233 bold
color main-remote      color75 color233
color main-tracked     color75 color233
color main-tag         color198 color233
color main-local-tag   color198 color233
color main-ref         color79 color233
color main-replace     color203 color233
color main-stash       color135 color233
color main-note        color35 color233
color main-prefetch    color75 color233
color main-other       color231 color233

# Status view
color stat-none        color239 color233
color stat-staged      color35 color233
color stat-unstaged    color221 color233
color stat-untracked   color203 color233

# Help view
color help-group     color221 color233 bold
color help-action    color231 color233

# Tree view
color tree.directory color74 color233
color tree.file      color231 color233
