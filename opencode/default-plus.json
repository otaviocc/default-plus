{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "background": "#171717",
    "backgroundPanel": "#111111",
    "backgroundElement": "#111111",
    "foreground": "#FFFFFF",
    "muted": "#4C4C4C",
    "mutedText": "#8E8E8E",
    "subtle": "#242424",
    "selection": "#515B70",

    "comment": "#2EA85B",
    "string": "#FC4651",
    "keyword": "#F2248C",
    "number": "#FFE76D",
    "macro": "#FD8F3F",
    "attribute": "#E09D65",
    "url": "#4FA5FF",
    "declaration": "#35B0D8",
    "declarationType": "#66DAFF",
    "projectIdentifier": "#56D0B3",
    "systemMember": "#AB64FF",
    "systemType": "#D0A8FF",

    "error": "#F74A4A",
