{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "background": "#1E1E1E",
    "backgroundPanel": "#181818",
    "backgroundElement": "#181818",
    "foreground": "#FFFFFF",
    "muted": "#4D4D4D",
    "mutedText": "#8E8E8E",
    "subtle": "#2A2A2A",
    "red": "#FC4651",
    "green": "#2EA85B",
    "yellow": "#FFE76D",
    "blue": "#35B0D8",
    "magenta": "#F2248C",
    "cyan": "#56D0B3",
    "diffAddedBg": "#1E2A20",
    "diffRemovedBg": "#2A1E1F"
  },
  "theme": {
    "primary": "blue",
    "secondary": "cyan",
    "accent": "magenta",
    "text": "foreground",
    "textMuted": "mutedText",

    "background": "background",
    "backgroundPanel": "backgroundPanel",
    "backgroundElement": "backgroundElement",

    "border": "muted",
    "borderActive": "blue",
    "borderSubtle": "subtle",

    "error": "red",
    "warning": "yellow",
    "success": "green",
    "info": "blue",

    "diffAdded": "green",
    "diffRemoved": "red",
    "diffContext": "mutedText",
    "diffAddedBg": "diffAddedBg",
    "diffRemovedBg": "diffRemovedBg",
    "diffContextBg": "background",
    "diffLineNumber": "muted",
    "diffAddedLineNumberBg": "diffAddedBg",
    "diffRemovedLineNumberBg": "diffRemovedBg",
    "diffHunkHeader": "cyan",
    "diffHighlightAdded": "green",
    "diffHighlightRemoved": "red",

    "markdownText": "foreground",
    "markdownHeading": "blue",
    "markdownLink": "cyan",
    "markdownCode": "yellow",
    "markdownBlockQuote": "mutedText",
    "markdownEmph": "yellow",
    "markdownStrong": "foreground",
    "markdownHorizontalRule": "muted",
    "markdownListItem": "cyan",
    "markdownListEnumeration": "blue",
    "markdownImage": "magenta",
    "markdownImageText": "mutedText",
    "markdownCodeBlock": "backgroundPanel",

    "syntaxComment": "mutedText",
    "syntaxKeyword": "magenta",
    "syntaxFunction": "blue",
    "syntaxVariable": "foreground",
    "syntaxString": "green",
    "syntaxNumber": "yellow",
    "syntaxType": "cyan",
    "syntaxOperator": "red",
    "syntaxPunctuation": "mutedText"
  }
}
