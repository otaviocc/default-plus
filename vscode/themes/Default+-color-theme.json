  "tokenColors": [

    // -------------------------------------------------------------------------
    // Comments
    // -------------------------------------------------------------------------
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8E8E8E",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comment",
      "scope": [
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#8E8E8E",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comment keywords (@param, @returns, etc.)",
      "scope": [
        "comment.block.documentation keyword",
        "comment.block.documentation storage.type.class"
      ],
      "settings": {
        "foreground": "#8E8E8E",
        "fontStyle": "bold italic"
      }
    },

    // -------------------------------------------------------------------------
    // Keywords & control flow  →  magenta
    // -------------------------------------------------------------------------
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.trycatch",
        "keyword.other",
        "keyword.declaration",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#F2248C",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Keyword — import/include/using  →  orange (preprocessor-like)",
      "scope": [
        "keyword.control.import",
        "keyword.control.include",
        "keyword.control.from",
        "keyword.other.using",
        "keyword.other.import"
      ],
      "settings": {
        "foreground": "#FD8F3F",
        "fontStyle": ""
      }
    },
    {
      "name": "Operator  →  red",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.bitwise",
        "keyword.operator.ternary",
        "keyword.operator.type"
      ],
      "settings": {
        "foreground": "#FC4651",
        "fontStyle": ""
      }
    },
    {
      "name": "Arrow operator  →  magenta",
      "scope": [
        "storage.type.function.arrow",
        "keyword.operator.arrow"
      ],
      "settings": {
        "foreground": "#F2248C",
        "fontStyle": ""
      }
    },
    {
      "name": "new / delete / typeof / instanceof  →  magenta",
      "scope": [
        "keyword.operator.new",
        "keyword.operator.delete",
        "keyword.operator.typeof",
        "keyword.operator.instanceof",
        "keyword.operator.in",
        "keyword.operator.of",
        "keyword.operator.expression.in",
        "keyword.operator.expression.of",
        "keyword.operator.expression.instanceof",
        "keyword.operator.expression.typeof",
        "keyword.operator.expression.void",
        "keyword.operator.expression.delete"
      ],
      "settings": {
        "foreground": "#F2248C",
        "fontStyle": "bold"
      }
    },

    // -------------------------------------------------------------------------
    // Strings  →  green
    // -------------------------------------------------------------------------
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.single",
        "string.quoted.double",
        "string.quoted.triple",
        "string.template",
        "string.interpolated"
      ],
      "settings": {
        "foreground": "#2EA85B",
        "fontStyle": ""
      }
    },
    {
      "name": "String punctuation (quotes)",
      "scope": [
        "punctuation.definition.string",
        "punctuation.definition.string.begin",
        "punctuation.definition.string.end"
      ],
      "settings": {
        "foreground": "#2EA85B",
        "fontStyle": ""
      }
    },
    {
      "name": "Template expression punctuation",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#FC4651",
        "fontStyle": ""
      }
    },

    // -------------------------------------------------------------------------
    // Regex  →  red
    // -------------------------------------------------------------------------
    {
      "name": "Regular expression",
      "scope": [
        "string.regexp",
        "constant.regexp"
      ],
      "settings": {
