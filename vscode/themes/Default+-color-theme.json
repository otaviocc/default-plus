{
  "name": "Default+",
  "$schema": "vscode://schemas/color-theme",
  "type": "dark",
  "colors": {

    // -------------------------------------------------------------------------
    // Editor core
    // -------------------------------------------------------------------------
    "editor.background": "#1E1E1E",
    "editor.foreground": "#FFFFFF",
    "editorCursor.foreground": "#FFFFFF",
    "editorCursor.background": "#1E1E1E",

    // Selection
    "editor.selectionBackground": "#54554A",
    "editor.inactiveSelectionBackground": "#54554A99",
    "editor.selectionHighlightBackground": "#54554A66",
    "editor.selectionHighlightBorder": "#00000000",

    // Line highlight
    "editor.lineHighlightBackground": "#2A2A2A",
    "editor.lineHighlightBorder": "#00000000",

    // Line numbers
    "editorLineNumber.foreground": "#4D4D4D",
    "editorLineNumber.activeForeground": "#FFE76D",

    // Whitespace / invisibles
    "editorWhitespace.foreground": "#4D4D4D",
    "editorIndentGuide.background1": "#2A2A2A",
    "editorIndentGuide.activeBackground1": "#4D4D4D",

    // Rulers
    "editorRuler.foreground": "#2A2A2A",

    // Brackets
    "editorBracketMatch.background": "#54554A",
    "editorBracketMatch.border": "#FFE76D",
    "editorBracketHighlight.foreground1": "#FFE76D",
    "editorBracketHighlight.foreground2": "#56D0B3",
    "editorBracketHighlight.foreground3": "#35B0D8",
    "editorBracketHighlight.foreground4": "#F2248C",
    "editorBracketHighlight.foreground5": "#FC4651",
    "editorBracketHighlight.foreground6": "#E09D65",
    "editorBracketHighlight.unexpectedBracket.foreground": "#FC4651",

    // Folding
    "editor.foldBackground": "#2A2A2A",

    // Occurrences / word highlight
    "editor.wordHighlightBackground": "#54554A66",
    "editor.wordHighlightStrongBackground": "#54554ABB",
    "editor.wordHighlightBorder": "#00000000",
    "editor.wordHighlightStrongBorder": "#00000000",

    // Find / search highlight
    "editor.findMatchBackground": "#FFE76D40",
    "editor.findMatchBorder": "#FFE76D",
    "editor.findMatchHighlightBackground": "#FFE76D25",
    "editor.findMatchHighlightBorder": "#00000000",
    "editor.findRangeHighlightBackground": "#2A2A2A",
    "editor.findRangeHighlightBorder": "#00000000",

    // Hover / link
    "editorLink.activeForeground": "#4FA5FF",

    // -------------------------------------------------------------------------
    // Editor widgets & overlays
    // -------------------------------------------------------------------------
    "editorWidget.background": "#181818",
    "editorWidget.foreground": "#FFFFFF",
    "editorWidget.border": "#4D4D4D",
    "editorWidget.resizeBorder": "#35B0D8",

    "editorSuggestWidget.background": "#181818",
