    "editorSuggestWidget.foreground": "#FFFFFF",
    "editorSuggestWidget.selectedBackground": "#54554A",
    "editorSuggestWidget.selectedForeground": "#FFFFFF",
    "editorSuggestWidget.highlightForeground": "#FFE76D",
    "editorSuggestWidget.focusHighlightForeground": "#FFE76D",

    "editorHoverWidget.background": "#181818",
    "editorHoverWidget.foreground": "#FFFFFF",
    "editorHoverWidget.border": "#4D4D4D",
    "editorHoverWidget.statusBarBackground": "#1E1E1E",

    "editorGhostText.foreground": "#4D4D4D",

    // -------------------------------------------------------------------------
    // Diagnostics (squiggles & gutter icons)
