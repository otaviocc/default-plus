    "editorError.background": "#FC465110",
    "editorError.border": "#00000000",
    "editorWarning.foreground": "#FFE76D",
    "editorWarning.background": "#FFE76D10",
    "editorWarning.border": "#00000000",
    "editorInfo.foreground": "#35B0D8",
    "editorInfo.background": "#35B0D810",
    "editorInfo.border": "#00000000",
